# 本地开发用(复制为 .env)。容器里这些由 docker-compose 提供。
LUMINARI_PORT=8790
LUMINARI_HOST=127.0.0.1
LUMINARI_DATA_DIR=./data
# 与博客同一把(验签 zx_admin 的 SSO cookie);本地可留空
SESSION_SECRET=
# 站长兜底 token;留空则在数据目录生成 owner.token
LUMINARI_OWNER_TOKEN=
# 0 = 关闭访客使用 AI
LUMINARI_VISITOR_AI=1

# 大模型经博客 AI 网关(令牌在博客 admin「AI 密钥」页生成后填这里)。
# 不填 ZX_AI_GATEWAY_URL 时默认 http://localhost:3000/api/ai/v1(本地);
# 线上容器内由 docker-compose 注入 http://app:3000/api/ai/v1。
ZX_AI_GATEWAY_URL=
ZX_AI_APP_TOKEN=
